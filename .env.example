# ── AgentHub environment ──────────────────────────────────────────────────────
# Copy to .env.local (never commit real secrets). All variables are read
# server-side only; nothing here is exposed to the browser.

# Directory the dashboard persists its state to (optional).
# AGENT_HUB_DB_DIR=./db

# ── n8n runtime integration ───────────────────────────────────────────────────
# Base URL of the n8n instance AgentHub talks to.
N8N_BASE_URL=http://localhost:5678

# n8n API key (n8n → Settings → n8n API → Create API key).
# Keep this server-side. It is never returned to the browser.
N8N_API_KEY=

# Optional: the URL n8n registers production webhooks under, when it differs
# from N8N_BASE_URL (e.g. behind a reverse proxy / tunnel).
N8N_WEBHOOK_BASE_URL=

# Optional: request timeout in milliseconds (1000–60000, default 15000).
N8N_TIMEOUT_MS=15000

# Optional SSRF guard: comma-separated allowlist of hosts AgentHub may contact.
# When set, the n8n base URL and every webhook URL must match. Leave empty to
# allow any host (the configured base is always validated as http/https).
N8N_ALLOWED_HOSTS=

# Optional: set to "false" to forbid private/localhost n8n hosts. Default allows
# them so a local n8n works out of the box.
N8N_ALLOW_PRIVATE_HOSTS=true

# Optional server-only token for higher GitHub catalog API limits.
AGENTHUB_GITHUB_TOKEN=

# Optional locally provisioned Linux image pinned by @sha256 digest.
# Image must include Node and dependencies under
# /opt/agenthub-deps/<sha256 of saved lockfile>/node_modules.
AGENTHUB_TEMPLATE_BUILD_IMAGE=

# Optional trusted local Python 3.12 container image pinned by @sha256 digest.
# Required before the official Harness2 demo can run in isolation.
AGENTHUB_HARNESS2_IMAGE=
